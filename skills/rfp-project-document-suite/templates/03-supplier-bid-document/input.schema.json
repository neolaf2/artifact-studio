{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "供应商投标文件模版输入数据",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document",
    "sections",
    "artifact_data"
  ],
  "properties": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "template_id",
        "document_id",
        "title",
        "status",
        "version",
        "issue_date",
        "confidentiality"
      ],
      "properties": {
        "template_id": {
          "const": "03-supplier-bid-document"
        },
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "草案",
            "待审核",
            "待确认",
            "已确认",
            "已归档"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "issue_date": {
          "type": "string",
          "minLength": 1
        },
        "confidentiality": {
          "type": "string",
          "enum": [
            "内部受控",
            "受限",
            "公开"
          ]
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "section_id",
          "title",
          "paragraphs"
        ],
        "properties": {
          "section_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "paragraphs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "artifact_data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supplier",
        "requirement_responses",
        "implementation_plan",
        "commercial_offer",
        "deviations"
      ],
      "properties": {
        "supplier": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        },
        "requirement_responses": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        },
        "implementation_plan": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        },
        "commercial_offer": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        },
        "deviations": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        }
      }
    }
  },
  "not": {
    "anyOf": [
      {
        "required": [
          "font"
        ]
      },
      {
        "required": [
          "font_size"
        ]
      },
      {
        "required": [
          "color"
        ]
      },
      {
        "required": [
          "brand"
        ]
      },
      {
        "required": [
          "accent"
        ]
      },
      {
        "required": [
          "layout"
        ]
      },
      {
        "required": [
          "theme"
        ]
      },
      {
        "required": [
          "margin"
        ]
      },
      {
        "required": [
          "page"
        ]
      },
      {
        "required": [
          "paper"
        ]
      },
      {
        "required": [
          "header"
        ]
      },
      {
        "required": [
          "footer"
        ]
      },
      {
        "required": [
          "columns"
        ]
      },
      {
        "required": [
          "spacing"
        ]
      },
      {
        "required": [
          "style"
        ]
      },
      {
        "required": [
          "format"
        ]
      }
    ]
  }
}
