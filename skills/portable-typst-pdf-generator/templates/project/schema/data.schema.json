{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Application PDF data",
  "type": "object",
  "additionalProperties": false,
  "required": ["metrics", "records"],
  "properties": {
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value", "label", "note"],
        "properties": {
          "value": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "note": {"type": "string"}
        }
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "summary", "image", "alt", "tags"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "summary": {"type": "string", "minLength": 1},
          "image": {"type": "string", "pattern": "^(|/assets/[A-Za-z0-9._/-]+)$"},
          "alt": {"type": "string"},
          "tags": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
