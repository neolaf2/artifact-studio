{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "招标文件审核信息",
  "type": "object",
  "additionalProperties": false,
  "required": ["scope", "issues", "release_decision"],
  "properties": {
    "scope": {"type": "string", "minLength": 1},
    "issues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "location", "title", "description", "cause", "responsibility", "corrective_action", "release_condition", "severity", "status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "location": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "cause": {"type": "string", "minLength": 1},
          "responsibility": {"type": "string", "minLength": 1},
          "corrective_action": {"type": "string", "minLength": 1},
          "release_condition": {"type": "string", "minLength": 1},
          "severity": {"type": "string", "minLength": 1},
          "status": {"type": "string", "minLength": 1}
        }
      }
    },
    "release_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "condition", "required_actions"],
      "properties": {
        "status": {"type": "string", "minLength": 1},
        "condition": {"type": "string", "minLength": 1},
        "required_actions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
