{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HtmlFormConfig",
  "type": "object",
  "properties": {
    "document": {
      "type": "object"
    },
    "brand": {
      "type": "object",
      "properties": {
        "accent": {
          "type": "string"
        }
      }
    },
    "html": {
      "type": "object",
      "properties": {
        "default_mode": {
          "type": "string",
          "enum": [
            "display",
            "editor"
          ]
        },
        "paper": {
          "type": "string"
        }
      }
    }
  }
}
