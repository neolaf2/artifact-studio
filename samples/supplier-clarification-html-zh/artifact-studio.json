{
  "version": 1,
  "artifacts": [
    {
      "id": "clarification-html-display",
      "template": "form.display.html",
      "data": "data.yaml",
      "output": "output/clarification-display.html",
      "dataSchema": "schema/data.schema.json",
      "renderer": "html-display",
      "note": "Downstream HTML from AST (open data.json with Artifact AST Editor)"
    },
    {
      "id": "clarification-html-editor",
      "template": "form.editor.html",
      "data": "data.yaml",
      "output": "output/clarification-editor.html",
      "dataSchema": "schema/data.schema.json",
      "renderer": "html-editor"
    },
    {
      "id": "clarification-pdf",
      "template": "letter.typ",
      "data": "data.yaml",
      "output": "output/clarification.pdf",
      "dataSchema": "schema/data.schema.json",
      "renderer": "typst",
      "note": "Downstream Typst PDF from the same AST"
    }
  ],
  "ast": {
    "data": "data.json",
    "dataTwin": "data.yaml",
    "schema": "schema/data.schema.json",
    "ontology": "ontology.md",
    "editor": "artifactStudio.artifactEditor",
    "note": "Combined data + JSON Schema + T-box ontology is the AST for upstream editing and downstream HTML/Typst rendering."
  }
}
