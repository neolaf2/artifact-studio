{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "version",
    "artifacts"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "ast": {
      "type": "object",
      "description": "Declared T-box / A-box / R-box / views roles. Consumed by the project model for role assignment."
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "template", "data"],
        "allOf": [
          {
            "if": { "not": { "properties": { "renderer": { "const": "review-box" } }, "required": ["renderer"] } },
            "then": { "required": ["output"] }
          }
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "template": {
            "type": "string",
            "description": "Typst .typ or HTML .html template"
          },
          "data": {
            "type": "string",
            "pattern": "\\.(json|yaml|yml)$"
          },
          "output": {
            "type": "string",
            "description": ".pdf or .html output"
          },
          "renderer": {
            "type": "string",
            "enum": [
              "typst",
              "html-display",
              "html-editor",
              "review-box"
            ],
            "description": "Build backend. Inferred from template/output when omitted."
          },
          "kind": {
            "type": "string",
            "description": "Free-form role label (view, rbox, ...). Advisory; roles come from the ast block."
          },
          "theme": {
            "type": "string",
            "description": "Optional CSS theme for HTML artifacts (default theme.css)."
          },
          "ontology": {
            "type": "string"
          },
          "dataSchema": {
            "type": "string",
            "description": "JSON Schema for data (required for html-editor)."
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
