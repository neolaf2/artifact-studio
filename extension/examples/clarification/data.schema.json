{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "title",
    "project",
    "recipient",
    "reference",
    "questions"
  ],
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string"
    },
    "project": {
      "type": "string"
    },
    "recipient": {
      "type": "string"
    },
    "reference": {
      "type": "string"
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "item",
          "question"
        ],
        "additionalProperties": false,
        "properties": {
          "item": {
            "type": "string"
          },
          "question": {
            "type": "string"
          }
        }
      }
    }
  }
}
