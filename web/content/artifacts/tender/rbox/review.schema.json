{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artifact.studio/schemas/review-box.schema.json",
  "title": "Artifact Studio ReviewBox (R-box)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "binding",
    "rules",
    "findings",
    "releaseDecision"
  ],
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "artifact-studio/v1"
    },
    "kind": {
      "type": "string",
      "const": "ReviewBox"
    },
    "metadata": {
      "type": "object",
      "required": [
        "id",
        "title",
        "version"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string"
        }
      }
    },
    "binding": {
      "type": "object",
      "required": [
        "abox",
        "tbox"
      ],
      "additionalProperties": false,
      "properties": {
        "abox": {
          "type": "object",
          "required": [
            "path",
            "artifactId",
            "snapshotVersion",
            "contentHash"
          ],
          "additionalProperties": true,
          "properties": {
            "path": {
              "type": "string"
            },
            "artifactId": {
              "type": "string"
            },
            "snapshotVersion": {
              "type": "string"
            },
            "contentHash": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          }
        },
        "tbox": {
          "type": "object",
          "required": [
            "schema",
            "ontology"
          ],
          "additionalProperties": true,
          "properties": {
            "schema": {
              "type": "string"
            },
            "ontology": {
              "type": "string"
            }
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "category",
          "severity",
          "title",
          "description"
        ],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "legality",
              "negative_list",
              "policy",
              "consistency",
              "commercial",
              "cross_doc"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "appliesTo": {
            "type": "object",
            "additionalProperties": true
          },
          "check": {
            "type": "object",
            "additionalProperties": true
          },
          "legalBasis": {
            "type": "string"
          },
          "remediation": {
            "type": "string"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "ruleId",
          "severity",
          "status",
          "title",
          "description"
        ],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string"
          },
          "ruleId": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pending_review",
              "confirmed",
              "waived",
              "fixed"
            ]
          },
          "location": {
            "type": "object",
            "properties": {
              "chapter": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            },
            "additionalProperties": true
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "cause": {
            "type": "string"
          },
          "responsibility": {
            "type": "string"
          },
          "correctiveAction": {
            "type": "string"
          },
          "releaseCondition": {
            "type": "string"
          },
          "evidence": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "releaseDecision": {
      "type": "object",
      "required": [
        "status",
        "condition",
        "requiredActions"
      ],
      "additionalProperties": true,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "not_ready",
            "ready_with_conditions",
            "ready"
          ]
        },
        "statusLabel": {
          "type": "string"
        },
        "condition": {
          "type": "string"
        },
        "requiredActions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    }
  }
}
