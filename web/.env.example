# Required for real LLM generation (OpenAI-compatible Chat Completions)
ARTIFACT_STUDIO_LLM_API_KEY=
ARTIFACT_STUDIO_LLM_BASE_URL=https://api.openai.com/v1
ARTIFACT_STUDIO_LLM_MODEL=gpt-4o-mini
ARTIFACT_STUDIO_LLM_TEMPERATURE=0.2

# Offline deterministic stub (no API key). Prefer unset when using a real endpoint.
# ARTIFACT_STUDIO_LLM_MOCK=1

# --- Durable A-box save (Vercel / production) ---
# Preferred: GitHub Contents API write-back so samples stay source of truth.
# Create a fine-grained PAT with Contents: Read and write on this repo.
ARTIFACT_STUDIO_GITHUB_TOKEN=
ARTIFACT_STUDIO_GITHUB_REPO=neolaf2/artifact-studio
ARTIFACT_STUDIO_GITHUB_BRANCH=main

# Optional alternative: Vercel Blob (if GitHub token is unavailable).
# ARTIFACT_STUDIO_BLOB_READ_WRITE_TOKEN=

# Local/dev always writes web/content/artifacts/<id>/data.json (+ yaml twin if present).
# On Vercel without the tokens above, FS writes are ephemeral — configure GitHub token.
